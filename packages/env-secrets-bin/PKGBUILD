# Maintainer: Nikolay Arhipov <n at arhipov dot net>
pkgname=env-secrets-bin
pkgver=0.0.7
pkgrel=1
pkgdesc="A CLI tool to set env variables with secrets in shell from the secret-service"
arch=('x86_64' 'aarch64')
url="https://github.com/nikarh/env-secrets"
license=('MIT')
optdepends=('org.freedesktop.secrets: a running Secret Service provider, e.g. gnome-keyring or keepassxc')
provides=('env-secrets')
conflicts=('env-secrets')

_source() {
	echo "env-secrets-$1-unknown-linux-gnu-v${pkgver}.tar.gz::https://github.com/nikarh/env-secrets/releases/download/v${pkgver}/env-secrets-$1-unknown-linux-gnu-v${pkgver}.tar.gz"
}

source_x86_64=("$(_source x86_64)")
source_aarch64=("$(_source aarch64)")

sha256sums_x86_64=('428a70bfddacbc5f1d1687a5627bff2b63054a75f64bc5a415f2f00c3d13112f')
sha256sums_aarch64=('ad7b4be922d3019953c768213f06a80ed5a43aee2827ca8b4e836b5bcc8ee515')

package() {
	install -Dm755 "${srcdir}/env-secrets" "${pkgdir}/usr/bin/env-secrets"
	install -Dm644 "${srcdir}/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
