    'libxtst'
    'miniupnpc'
    'numactl'
    'openssl'
    'opus'
    'qt6-base'
    'qt6-svg'
    'udev'
    'vulkan-icd-loader'
    'which'
)
optdepends=(
    'cuda: Nvidia GPU encoding support'
    'libva-mesa-driver: AMD GPU encoding support'
    'xorg-server-xvfb: Virtual X server for headless testing'
)
# makedepends=('patchelf')
conflicts=('sunshine-bin')
provides=()
b2sums=('104008bd7999e8d938a1b559e6277aea60a29242a62a1d00bdce32ef1ce2125954ff11f8657f3f4cb3edc60a0d48e4a4c9ac80a5556f0166e5bc35fc94938101')

