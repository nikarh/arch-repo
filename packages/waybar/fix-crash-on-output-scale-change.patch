From 920345f92b36cbb9776d98eda0cdcdc3b2c73715 Mon Sep 17 00:00:00 2001
From: Nikolay Arhipov <n@arhipov.net>
Date: Tue, 3 Nov 2026 22:00:14 +0200
Subject: [PATCH] fix(bar): waybar crashes when an output's scale changes

Waybar dies whenever the scale of an output it has a bar on changes, if the
bar's size is not divisible by the new scale (any odd bar height, e.g. the
common "height": 35, at scale 2). The compositor kills the connection with a
protocol error and waybar exits:

  wl_display#1.error(wl_surface#42, 2, "Buffer size (1920x35) is not divisible by scale (2)")
  Gdk-Message: Error 71 (Protocol error) dispatching to Wayland display.

This is a regression on master, 0.15.0 is not affected.

Steps to reproduce (sway):

  1. Config: { "height": 35, "modules-left": ["clock"] }
  2. Start waybar with an output at scale 1.
  3. swaymsg output <name> scale 2
  -> waybar exits.

It also crashes without any scale command: when a bar on a scale-1 output
starts overlapping a scale-2 output (e.g. while a display configurator such
as nwg-displays moves outputs around), GTK raises that bar's buffer scale
and the same error follows.

Cause: since 942411d7 ("Force layer-shell commit after configure") the bar
calls gtk_layer_try_force_commit() after every configure. On a scale change
GTK sends wl_surface.set_buffer_scale immediately but attaches a buffer of
the new scale only on its next paint. The forced bare commit in between
applies the new scale to the old buffer, which the compositor rejects.

Fix: remember the scale of the last painted buffer and skip the forced
commit while it differs from the window's current scale. GTK has already
queued a redraw and commits a correctly sized buffer itself. Before anything
has been painted no buffer is attached, so the late-initial-configure case
the forced commit was added for is unaffected.
---
 include/bar.hpp |  2 ++
 src/bar.cpp     | 19 ++++++++++++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/include/bar.hpp b/include/bar.hpp
index b0e45731..3979f510 100644
--- a/include/bar.hpp
+++ b/include/bar.hpp
@@ -127,6 +127,8 @@ class Bar : public sigc::trackable {
 
   struct bar_margins margins_;
   uint32_t width_, height_;
+  /* Scale of the last buffer GTK painted for this window (0: nothing painted yet) */
+  int painted_scale_ = 0;
   bool passthrough_;
 #ifdef HAVE_BAR_BLUR
   bool blur_enabled_ = false;
diff --git a/src/bar.cpp b/src/bar.cpp
index 07598d55..5157cfbe 100644
--- a/src/bar.cpp
+++ b/src/bar.cpp
@@ -237,6 +237,12 @@ waybar::Bar::Bar(struct waybar_output* w_output, const Json::Value& w_config)
   }
 
   window.signal_configure_event().connect_notify(sigc::mem_fun(*this, &Bar::onConfigure));
+  window.signal_draw().connect(
+      [this](const Cairo::RefPtr<Cairo::Context>&) {
+        painted_scale_ = window.get_scale_factor();
+        return false;
+      },
+      false);
   output->monitor->property_geometry().signal_changed().connect(
       sigc::mem_fun(*this, &Bar::onOutputGeometryChanged));
 
@@ -431,7 +437,18 @@ void waybar::Bar::setMode(const struct bar_mode& mode) {
 void waybar::Bar::forceLayerCommit() {
   auto* gtk_window = window.gobj();
   if (gtk_window != nullptr && gtk_widget_get_realized(GTK_WIDGET(gtk_window))) {
-    gtk_layer_try_force_commit(gtk_window);
+    /*
+     * On a scale change GTK sets the new buffer scale immediately but attaches a matching buffer
+     * only on its next paint. Committing in between applies the new scale to the old buffer, a
+     * protocol error that gets waybar disconnected. GTK commits itself once it has repainted.
+     */
+    int scale = window.get_scale_factor();
+    if (painted_scale_ != 0 && painted_scale_ != scale) {
+      spdlog::debug("Output {} scale changed {} -> {}, skipping forced commit until repainted",
+                    output->name, painted_scale_, scale);
+    } else {
+      gtk_layer_try_force_commit(gtk_window);
+    }
   }
   wl_display_flush(Client::inst()->wl_display);
 }
